{
    "name": "usman-shamim/bagisto-automation",
    "description": "Bearer-token REST API, admin review queue, and signed outbound webhooks for Bagisto. Built as the integration substrate for external AI agents (n8n, Make, custom).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "bagisto",
        "laravel",
        "ecommerce",
        "automation",
        "ai-agent",
        "n8n",
        "webhooks",
        "rest-api"
    ],
    "authors": [
        {
            "name": "Usman Shamim",
            "homepage": "https://github.com/usman-shamim"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/cache": "^11.0|^12.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Webkul\\Automation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webkul\\Automation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webkul\\Automation\\Providers\\AutomationServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
